---
/*
 * Home page: one column per category, side by side, each showing
 * its latest posts and a link to the full category page.
 */
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import CategoryHeader from '../components/CategoryHeader.astro';
import PostEntry from '../components/PostEntry.astro';
import { categories } from '../data/categories';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const columns = categories.map((category) => {
  const inCategory = posts.filter((p) => p.data.category === category.slug);
  return {
    category,
    total: inCategory.length,
    latest: inCategory.slice(0, site.postsPerCategoryOnHome),
  };
});
---

<BaseLayout>
  <PageHeading title={site.title} aside={site.tagline} />

  <div class="columns" style={`--column-count: ${columns.length}`}>
    {
      columns.map(({ category, total, latest }) => (
        <section class="column" aria-label={category.name}>
          <CategoryHeader category={category} link />
          <div class="column__entries">
            {latest.map((post) => <PostEntry post={post} />)}
            {total === 0 && <p class="column__empty mono-label">No posts yet</p>}
          </div>
          <footer class="column__footer">
            <a class="mono-label" href={url(`/category/${category.slug}/`)}>
              All {total} {total === 1 ? 'post' : 'posts'} →
            </a>
          </footer>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(var(--column-count), minmax(0, 1fr));
    border-bottom: var(--rule-thick) solid var(--color-rule);
  }

  /* Columns stretch to equal height, so the footer links line up. */
  .column {
    display: flex;
    flex-direction: column;
  }

  .column + .column {
    border-left: var(--rule-thick) solid var(--color-rule);
  }

  .column__entries {
    flex: 1;
  }

  .column__empty {
    padding: 1.2rem var(--gutter);
    color: var(--color-muted);
  }

  .column__footer {
    padding: 2.5rem var(--gutter) 1.4rem;
  }

  .column__footer a {
    color: var(--color-link);
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .column + .column {
      border-left: 0;
      border-top: var(--rule-thick) solid var(--color-rule);
    }
    .column__footer {
      padding-top: 1.4rem;
    }
  }
</style>
